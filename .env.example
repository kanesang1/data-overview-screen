# Browser requests use a same-origin path. Vite/Nginx forwards it to the backend.
VITE_APP_ENV=development
VITE_API_BASE_URL=/api/bi/
VITE_API_TIMEOUT=15000

# Fallback admin URL when the screen is opened without a returnUrl query parameter.
VITE_ADMIN_URL=http://8.148.14.229:3000/

# Used only by the Vite development server and is not exposed to browser code.
API_PROXY_TARGET=http://8.148.14.229:8080

# Configure automatic screen login in ignored .env.local.
# VITE_ values are embedded in browser builds; use a dedicated read-only account for delivery.
VITE_SCREEN_LOGIN_USERNAME=
VITE_SCREEN_LOGIN_PASSWORD=

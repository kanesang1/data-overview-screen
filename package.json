{
  "name": "data-overview-screen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:test": "vite --mode test --host 0.0.0.0",
    "build": "node scripts/build.mjs production",
    "build:dev": "node scripts/build.mjs development",
    "build:test": "node scripts/build.mjs test",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc -b --force",
    "prepare:images": "node scripts/prepare-images.mjs",
    "prepare:native": "node scripts/prepare-native.mjs",
    "build:native": "node scripts/build-native.mjs",
    "package:native": "node scripts/package.mjs --native",
    "package": "node scripts/package.mjs",
    "build:web": "node scripts/build.mjs production --web-only"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "echarts": "^5.6.0",
    "vue": "^3.5.13",
